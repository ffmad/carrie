{
  "name": "carrie",
  "private": true,
  "description": "Carrie — the AI care go-between that carries the conversation between grandma, her family and her doctor",
  "scripts": {
    "dev:web": "npm --prefix frontend run dev",
    "dev:api": "npm --prefix backend run dev",
    "db:start": "supabase start --runtime native",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:migration": "supabase migration new",
    "db:types": "supabase gen types typescript --local > frontend/src/lib/database.types.ts"
  },
  "devDependencies": {
    "supabase": "2.121.0"
  }
}

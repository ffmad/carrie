# Copy to backend/.env (never commit the real file).
# Leave ANTHROPIC_API_KEY empty to run the scripted demo call instead of Claude.
ANTHROPIC_API_KEY=
# Only needed when the key is not tied to a single workspace (the API answers 400 without it).
ANTHROPIC_WORKSPACE_ID=
# Model for Carrie's turns. Default is the low-latency choice for a phone call.
CARRIE_MODEL=claude-sonnet-5-5
PORT=3050
